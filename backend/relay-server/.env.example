# relay-server 환경변수

PORT=4000

# 블록체인 RPC (로컬 hardhat node 기본값)
RPC_URL=http://127.0.0.1:8545

# relayer(가스 대납 지갑)의 프라이빗 키 — 절대 커밋 금지, 데모 전용 계정만 사용
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# contracts/deployments/<network>.json 배포 후 나오는 GoldenLock 주소
GOLDEN_LOCK_ADDRESS=0x0000000000000000000000000000000000000000
