# 테스트넷 배포용 (로컬 hardhatMainnet 네트워크에는 필요 없음)
DEPLOYER_PRIVATE_KEY=
ARBITRUM_SEPOLIA_RPC_URL=
POLYGON_AMOY_RPC_URL=

# 배포 시 GoldenLock.trustedRelayer로 설정할 relay-server 지갑 주소.
# 비워두면 배포자 주소를 임시로 사용하고, relay-server/.env의 relayer 주소로
# scripts/deploy.ts 실행 후 setTrustedRelayer로 갱신해야 한다.
TRUSTED_RELAYER_ADDRESS=
