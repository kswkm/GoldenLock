    "@types/mocha": "^10.0.7",
    "@types/node": "^20.12.12",
    "chai": "^5.1.1",
    "dotenv": "^16.4.5",
    "hardhat": "^3.0.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "ethers": "^6.13.0"
  }
