{
  "name": "@goldenlock/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GoldenLock 원자적 자원 확약(Atomic Lock) 스마트 컨트랙트 (Hardhat 3)",
  "scripts": {
    "compile": "hardhat compile",
