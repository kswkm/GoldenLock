# relay-server 환경변수

PORT=4000

# 블록체인 RPC (로컬 hardhat node 기본값)
RPC_URL=http://127.0.0.1:8545

# relayer(가스 대납 지갑)의 프라이빗 키 — 절대 커밋 금지, 데모 전용 계정만 사용.
# 이 지갑 주소는 contracts 배포 시 GoldenLock.trustedRelayer로 등록되어 있어야 한다
# (contracts/scripts/deploy.ts의 TRUSTED_RELAYER_ADDRESS 참고).
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# contracts/ 배포 후 나오는 GoldenLock 주소
GOLDEN_LOCK_ADDRESS=0x0000000000000000000000000000000000000000

# 프론트엔드가 서빙되는 origin (콤마로 여러 개 지정 가능). 기본값은 frontend/README.md가
# 권장하는 로컬 정적 서버 포트다. 배포 시 실제 도메인으로 좁힐 것.
FRONTEND_ORIGIN=http://localhost:5173
