FROM node:20-alpine AS build
WORKDIR /app
ARG NEXT_PUBLIC_RELAY_URL
ARG NEXT_PUBLIC_GOLDEN_LOCK_ADDRESS
ENV NEXT_PUBLIC_RELAY_URL=$NEXT_PUBLIC_RELAY_URL
ENV NEXT_PUBLIC_GOLDEN_LOCK_ADDRESS=$NEXT_PUBLIC_GOLDEN_LOCK_ADDRESS
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE 3000
CMD ["npm", "run", "start"]